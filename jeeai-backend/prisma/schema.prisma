generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  WHATSAPP
  INSTAGRAM
  FACEBOOK_MESSENGER
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  ERROR
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique
  displayName       String
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  contacts          Contact[]
  conversations     Conversation[]
  connectedAccounts ConnectedAccount[]
  preference        UserPreference?
}

model Contact {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  name           String
  username       String?
  profileImage   String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations  Conversation[]

  // Composite key supports a conversation FK that enforces same-user ownership.
  @@unique([userId, id])
  @@index([userId, name])
}

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  contactId     String    @db.Uuid
  platform      Platform
  lastMessageAt DateTime? @db.Timestamptz(6)
  unreadCount   Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact       Contact   @relation(fields: [userId, contactId], references: [userId, id], onDelete: Cascade)
  messages      Message[]

  @@unique([userId, contactId, platform])
  @@index([userId, lastMessageAt])
  @@index([contactId])
  @@index([platform])
}

model Message {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @db.Uuid
  content        String
  direction      MessageDirection
  status         MessageStatus    @default(SENT)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([status])
}

model ConnectedAccount {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  platform          Platform
  externalAccountId String
  displayName       String
  connectionStatus  ConnectionStatus @default(DISCONNECTED)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, externalAccountId])
  @@index([userId, connectionStatus])
}

model UserPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  preferredLanguage    String   @default("en")
  responseTone          String   @default("friendly")
  emojiPreference      Boolean  @default(true)
  personalInstructions String?
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
