NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL. Replace these placeholders locally; never commit .env.
DATABASE_URL=postgresql://jeeai_local:replace-with-local-password@localhost:5432/jeeai_dev?schema=public
TEST_DATABASE_URL=postgresql://jeeai_local:replace-with-local-password@localhost:5432/jeeai_test?schema=public
POSTGRES_DB=jeeai_dev
POSTGRES_USER=jeeai_local
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
